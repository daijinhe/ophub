# ===== 镜像地址：内网 Harbor（harbor.internal.example）=====
# 部署目录里没有源码，四个服务全部靠 pull 拉取，绝不在内网构建。
# 发新版时只改这两行的版本号，然后 docker compose pull && docker compose up -d
POSTGRES_IMAGE=harbor.internal.example/your-project/postgres:16
REDIS_IMAGE=harbor.internal.example/your-project/redis:7.4.10
BACKEND_IMAGE=harbor.internal.example/your-project/ophub-backend:v1.7.8
FRONTEND_IMAGE=harbor.internal.example/your-project/ophub-frontend:v1.7.8

# ===== 数据持久化（主机目录挂载，替代 docker volume）=====
# 让 PG 数据看得见摸得着、好迁移、好备份。
# 必须用 move-pgdata-to-host.sh 把旧 docker volume 内容搬过来再启动 PG。
PGDATA_HOST=/data/your-project/ophub/data/postgresql

# ===== 数据库 =====
# 必须与导出的旧库一致，否则还原后连不上
DB_USER=ophub
DB_PASSWORD=ophub123
DB_NAME=ophub

# ===== 安全（v1.7.1+ 强制校验，ENV 不是 dev 时会校验）=====
#
# 生成新密钥（二选一）：
#   openssl rand -base64 48
#   head -c 48 /dev/urandom | base64
#
# JWT_SECRET  —— 可以（也建议）重新生成强随机值。影响：所有人需要重新登录一次。
# PWD_ENC_KEY —— 【绝对不能改！】必须原样照搬迁移包里 PWD_ENC_KEY.txt 的值。
#                 它是 AES-GCM 密钥，用来加解密资产里存的 SSH 密码 / sudo 密码。
#                 换成新值 => 库里所有已存凭据全部解不开，表现为「密码错误」，
#                 且无法恢复（只能逐个资产重新录入密码）。
JWT_SECRET=请替换成-openssl-rand-base64-48-的输出
PWD_ENC_KEY=请原样粘贴迁移包里PWD_ENC_KEY.txt的内容

# ===== 运行环境 =====
# dev 会跳过上面的密钥强度校验；内网部署请设 production
ENV=production

# ===== 公开注册（v1.7.1+ P1-1）=====
# 默认 false：不允许未登录用户自助注册。首次部署库里已有 admin，保持 false。
ALLOW_PUBLIC_REGISTER=false

# ===== WebSocket 安全开关（v1.7.1+）=====
# 只影响 Web 终端。留空 = 只允许同源（浏览器直接访问平台 IP:端口即同源，够用）。
ALLOW_WS_TOKEN_URL=true
ALLOW_WS_ORIGINS=
ALLOW_WS_ANY_ORIGIN=false

# ===== SSH known_hosts（v1.7.1+ P0-4）=====
# 挂 backend-data 卷，容器重建后指纹库不丢
KNOWN_HOSTS_FILE=/data/known_hosts.json
ALLOW_TEMP_TRUST=false

# ===== 前端端口（宿主机映射）=====
WEB_PORT=10001

# ===== 中间件离线安装包根目录（在 Ansible 控制节点上）=====
DEPLOY_BASE=/data/jenkins_home/scripts/V2_Project_App_Init_Install/main/app_choice
SYSTEM_INIT_DIR=/data/jenkins_home/scripts/V2_Project_App_Init_Install/main/system_init

# ===== 脚本管理「平台本机」模式挂载的宿主机目录 =====
# 该目录在服务器上不存在时 docker 会自动创建一个空目录（功能可用但列不出脚本）。
# 改成服务器上真实存在的脚本目录即可。
SCRIPT_HOST_ROOT=/data/jenkins_home/scripts/Java_Start_Stop_SH

# ===== 本机 Ansible 配置目录（v1.7.11+）=====
# 「本机 Ansible 管理」页面管理的 hosts 文件所在目录（容器内路径固定 /etc/ansible）。
# 必须 bind-mount 一个真实存在的宿主机目录，平台才看得到服务器本身的 ansible 配置。
# 服务器一般用默认 /etc/ansible；改这里后要重建 backend 容器才生效。
ANSIBLE_HOSTS_DIR=/etc/ansible

# ===== 平台 ansible 采集通道模式（v1.7.15+）=====
# 决定资源校准 / 中间件捕捉 / 智能巡检 / 定时任务等所有调用 ansible 的场景走哪条通道：
#   local  = 强制用服务器本机（backend 容器内）的 ansible（内网部署推荐，不需要远端控制节点）
#   remote = 强制用「远端 Ansible 管理」里的控制节点
#   auto   = 本机可用走本机，否则走远端（默认）
# 这里只是初始值/兜底值；页面「本机 Ansible 管理 → 平台采集通道」改过之后以数据库为准。
# ANSIBLE_RUNNER_MODE=local
