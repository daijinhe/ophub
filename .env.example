# ===== 数据库 =====
DB_USER=ophub
DB_PASSWORD=ophub123
DB_NAME=ophub

# ===== 安全（v1.7.1+ 强制要求）=====
#
# 在生产（非 ENV=dev）环境里启动时 backend 会强制校验：
#   - JWT_SECRET  不能是 ophub-secret-change-me 或空
#   - PWD_ENC_KEY 不能是 ophub-default-pwd-enc-key-please-change 或空
# 如果仍是默认值，backend 直接 panic 拒绝启动！
#
# 生成强随机密钥（任选其一）：
#   openssl rand -base64 48
#   head -c 48 /dev/urandom | base64
#
JWT_SECRET=ophub-secret-change-me
PWD_ENC_KEY=

# ===== 公开注册开关（v1.7.1+ P1-1）=====
# 默认 false：未设置 env 即不允许未登录用户通过 /api/auth/register 新增账号。
# 真要开放时设为 true（如首次部署生成首个用户），其它情况建议保持 false。
ALLOW_PUBLIC_REGISTER=false

# ===== WebSocket ticket 兼容开关（v1.7.1+ P0-2/P1-5）=====
# 默认 false：客户端必须先 POST /api/ws/ssh/ticket 拿一次性 ticket，再用 ticket 而非
#              token 升级 WebSocket（避免 token 进 nginx access log）。
# 设为 true 临时切回 ?token= URL 形式（限过渡期使用）。
ALLOW_WS_TOKEN_URL=true

# ===== WebSocket Origin 白名单（v1.7.1+ P0-2 / v1.7.2 修正）=====
# 逗号分隔的「额外」允许来源；**留空即可**：留空时只允许同源
#   （浏览器打开 http://<平台IP>:8088 访问，Origin 与 Host 一致 → 放行）。
# 平台在内网会被不同 IP / 主机名访问，同源判定已覆盖绝大多数场景，
# 不要为了「放行」而把 CORS 的 * 抄过来（那样等于关掉跨站劫持防护）。
# 仅当前端与后端**确实不同源**时才需要在此列出，例如：
#   ALLOW_WS_ORIGINS=https://ophub.corp.com,http://asset-01.internal.example:8088
# 列表里单独写一个 `*` 表示全放行（仅调试期）。
ALLOW_WS_ORIGINS=

# 内网调试用：true 时 ws 接受任意 Origin（**仅开发环境**，生成请保持 false）
ALLOW_WS_ANY_ORIGIN=false

# ===== SSH known_hosts（v1.7.1+ P0-4）=====
# 平台首次连接 SSH host 时自动 pin 公钥写入此文件；之后严格比对，防止 MITM。
# 容器化部署建议挂载到持久卷。
KNOWN_HOSTS_FILE=/data/known_hosts.json

# 临时信任模式：true 时 PIN 仅存内存（容器重启即丢，用于「同镜像大批量迁移」的场景）
ALLOW_TEMP_TRUST=false

# ===== 前端访问端口（宿主机映射）=====
WEB_PORT=8088

# ===== 离线中间件安装包根目录（控制节点上 <DEPLOY_BASE>/<中间件subDir>/files/）=====
DEPLOY_BASE=/data/jenkins_home/scripts/V2_Project_App_Init_Install/main/app_choice

# ===== 脚本管理「平台本机」模式要挂载的宿主机目录 =====
# 页面上的根路径默认就是它。平台跑在容器里时必须挂载，否则后端读到的是容器内的空目录。
# 改这里后需要重建 backend 容器（docker compose up -d --build backend）才会生效。
SCRIPT_HOST_ROOT=/data/jenkins_home/scripts/Java_Start_Stop_SH
