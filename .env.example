# ===== 数据库 =====
DB_USER=ophub
DB_PASSWORD=ophub123
DB_NAME=ophub

# ===== 安全 =====
# 请务必修改为随机长字符串！
JWT_SECRET=ophub-secret-change-me

# ===== 前端访问端口（宿主机映射）=====
WEB_PORT=8088

# ===== 离线中间件安装包根目录（控制节点上 <DEPLOY_BASE>/<中间件subDir>/files/）=====
DEPLOY_BASE=/data/jenkins_home/scripts/V2_Project_App_Init_Install/main/app_choice

# ===== 脚本管理「平台本机」模式要挂载的宿主机目录 =====
# 页面上的根路径默认就是它。平台跑在容器里时必须挂载，否则后端读到的是容器内的空目录。
# 改这里后需要重建 backend 容器（docker compose up -d --build backend）才会生效。
SCRIPT_HOST_ROOT=/data/jenkins_home/scripts/Java_Start_Stop_SH
